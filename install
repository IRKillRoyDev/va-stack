#!/usr/bin/env bash
# Install va-stack on this computer: a virtual environment, the va-stack
# command, and an application launcher.
#
# Apple Silicon (an M-series Mac) is arm64. This script runs Python with
# `arch -arm64` there, so a universal2 Python cannot install the Intel
# wheels under Rosetta. An Intel Mac is x86_64 and is not wrapped.
# Native Homebrew on Apple Silicon is /opt/homebrew. Intel Homebrew is
# /usr/local.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
PREFIX="${VA_STACK_PREFIX:-$HOME/.local/share/va-stack}"
BIN_DIR="${VA_STACK_BIN:-$HOME/.local/bin}"
PY=""

usage() {
  cat <<'EOF'
Usage: ./install [--prefix DIR] [--bin-dir DIR] [--python PATH]

Installs va-stack into DIR (default: ~/.local/share/va-stack), links the
va-stack command into ~/.local/bin, and adds an application launcher.
macOS: ~/Applications/va-stack.app. Linux: a desktop entry.

Apple Silicon Macs install the arm64 build. A Python that cannot start
as arm64 is refused. Install a native one with:
  brew install python@3.12 python-tk@3.12
  /opt/homebrew/bin/python3.12 ./install

An Intel Mac installs the x86_64 build and looks in /usr/local first.
The window also needs tkinter (python-tk on macOS, python3-tk on Linux).
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --prefix)
      PREFIX="${2:?}"
      shift 2
      ;;
    --bin-dir)
      BIN_DIR="${2:?}"
      shift 2
      ;;
    --python)
      PY="${2:?}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

is_apple_silicon() {
  [[ "$(uname -s)" == "Darwin" ]] || return 1
  if [[ "$(uname -m)" == "arm64" ]]; then
    return 0
  fi
  [[ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" == "1" ]]
}

FORCE=0
if is_apple_silicon; then
  FORCE=1
fi

run_py() {
  if [[ "$FORCE" == 1 ]]; then
    arch -arm64 "$@"
  else
    "$@"
  fi
}

python_ok() {
  local c="$1"
  if [[ "$c" == */* ]]; then
    [[ -x "$c" ]] || return 1
  else
    command -v "$c" >/dev/null 2>&1 || return 1
  fi
  run_py "$c" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' \
    && return 0
  return 1
}

pick_python() {
  local c candidates=()
  if [[ "$FORCE" == 1 ]]; then
    candidates=(
      /opt/homebrew/bin/python3.12
      /opt/homebrew/bin/python3.13
      /opt/homebrew/bin/python3.11
      /opt/homebrew/bin/python3
      /usr/local/bin/python3.12
      /usr/local/bin/python3.13
      /usr/local/bin/python3
      /Library/Frameworks/Python.framework/Versions/Current/bin/python3
      python3
    )
  elif [[ "$(uname -s)" == "Darwin" ]]; then
    candidates=(
      /usr/local/bin/python3.12
      /usr/local/bin/python3.13
      /usr/local/bin/python3.11
      /usr/local/bin/python3
      python3
    )
  else
    candidates=(python3 python3.12 python3.11 python3.13)
  fi
  for c in "${candidates[@]}"; do
    if python_ok "$c"; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

apple_help() {
  echo "This Mac is Apple Silicon. Install a native arm64 Python:" >&2
  echo "  brew install python@3.12 python-tk@3.12" >&2
  echo "  /opt/homebrew/bin/python3.12 \"$ROOT/install\"" >&2
}

if [[ -z "$PY" ]]; then
  if ! PY="$(pick_python)"; then
    echo "No usable Python 3.10+ found." >&2
    if [[ "$FORCE" == 1 ]]; then
      apple_help
    fi
    exit 1
  fi
fi

if ! python_ok "$PY"; then
  echo "Python failed to start as the right build: $PY" >&2
  if [[ "$FORCE" == 1 ]]; then
    echo "That Python did not run as arm64." >&2
    apple_help
  fi
  exit 1
fi

echo "Using $PY"
run_py "$PY" "$ROOT/scripts/platform_support.py" --check

mkdir -p "$PREFIX"
run_py "$PY" -m venv "$PREFIX/venv"
run_py "$PREFIX/venv/bin/python" -m pip install --upgrade pip
run_py "$PREFIX/venv/bin/python" -m pip install -r "$ROOT/requirements.txt"

if ! run_py "$PY" -c 'import tkinter' >/dev/null 2>&1; then
  echo "warning: tkinter is missing, so the window cannot open yet." >&2
  if [[ "$(uname -s)" == "Darwin" ]]; then
    echo "  brew install python-tk@3.12" >&2
    echo "  then run ./install again" >&2
  else
    echo "  install the python3-tk package, then run ./install again" >&2
  fi
fi

run_py "$PY" "$ROOT/scripts/install_layout.py" apply \
  --source "$ROOT" \
  --prefix "$PREFIX" \
  --python "$PREFIX/venv/bin/python" \
  --bin-dir "$BIN_DIR" \
  --force-arm64 "$FORCE"

echo "Installed va-stack."
echo "  command: $BIN_DIR/va-stack"
echo "  prefix:  $PREFIX"
if [[ "$(uname -s)" == "Darwin" ]]; then
  echo "  app:     $HOME/Applications/va-stack.app"
else
  data="${XDG_DATA_HOME:-$HOME/.local/share}"
  echo "  app:     $data/applications/va-stack.desktop"
fi
echo "  remove:  $PREFIX/uninstall"
case ":$PATH:" in
  *":$BIN_DIR:"*) ;;
  *)
    echo "Add the command directory to PATH:"
    echo "  export PATH=\"$BIN_DIR:\$PATH\""
    ;;
esac
